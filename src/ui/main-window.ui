<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="TagsMainWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="no">Tags</property>
    <property name="default-width">700</property>
    <property name="default-height">720</property>
    <property name="width-request">437</property>
	  <style>
      <!--<class name="devel"/>-->
	  </style>
    <property name="content">
      <object class="AdwOverlaySplitView" id="oversplit">
        <property name="content">
          <object class="AdwToolbarView">
            <property name="top_bar_style">flat</property>
            <child type="top">
              <object class="AdwHeaderBar">
                <child type="start">
                  <object class="GtkButton" id="button_open_file">
                    <property name="visible">true</property>
                    <property name="action-name">win.action_open_file</property>
                    <property name="child">
                      <object class="AdwButtonContent">
                        <property name="icon-name">document-open-symbolic</property>
                        <property name="label" translatable="yes" context="Open a file">_Open</property>
                        <property name="tooltip_text" translatable="yes" context="Open a file - tooltip">Select a File</property>
                        <property name="use-underline">true</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child type="title">
                  <object class="GtkStack" id="title_stack">
                    <!--<property name="transition-type">slide-left-right</property>-->
                    <property name="transition-type">crossfade</property>
                    <property name="halign">fill</property>
                    <property name="valign">fill</property>
                    <style>
                      <class name="title" />
                    </style>

                    <child>
                      <object class="GtkStackPage" id="stackpage_app_title">
                        <property name="name">apptitle</property>
                        <property name="child">
                          <object class="GtkStack">
                            <property name="halign">fill</property>
                            <property name="valign">fill</property>
                            <property name="transition-type">crossfade</property>
                            <child>
                              <object class="GtkStackPage" id="stackpage_app_title_sidebar">
                                <property name="name">apptitle_sidebar</property>
                                <property name="child">
                                  <object class="GtkLabel" id="title_sidebar">
                                    <style>
                                      <class name="dimmed" />
                                    </style>
                                    <property name="visible">true</property>
                                    <property name="ellipsize">middle</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage" id="stackpage_app_title_nosidebar">
                                <property name="name">apptitle_nosidebar</property>
                                <property name="child">
                                  <object class="AdwWindowTitle" id="title_nosidebar">
                                    <property name="visible">true</property>
                                    <property name="title" translatable="no">Tags</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>


                          <!--
                          <object class="GtkBox">
                          <property name="valign">center</property>
                          <property name="halign">center</property>
                          <property name="orientation">vertical</property>
                          <child>
                            <object class="GtkLabel" id="title_sidebar">
                              <style>
                                <class name="dimmed" />
                              </style>
                              <property name="visible">false</property>
                              <property name="ellipsize">middle</property>
                            </object>
                          </child>
                          <child>
                            <object class="AdwWindowTitle" id="title_nosidebar">
                              <property name="visible">false</property>
                              <property name="title" translatable="no">Tags</property>
                              </object>
                          </child>
                          </object>
                          -->
                        </property>
                      </object>
                    </child>

                    <child>
                      <object class="GtkStackPage" id="stackpage_search">
                        <property name="name">search</property>
                        <property name="child">
                          <object class="GtkSearchEntry" id="search_entry">
                            <property name="placeholder-text" translatable="yes">Search...</property>
                            <!--<property name="tooltip-text" translatable="yes">Search for text in visible lines</property>-->
                            <property name="input_purpose">free-form</property>
                            <property name="activates_default">true</property>
                            <property name="input_hints">none</property>
                            <property name="valign">center</property>
                            <property name="halign">center</property>
                            <property name="hexpand">true</property>
                          </object>
                        </property>
                      </object>
                    </child>

                  </object>
                </child>

                <child type="end">
                  <object class="GtkMenuButton">
                    <property name="primary">true</property>
                    <property name="icon-name">open-menu-symbolic</property>
                    <property name="menu-model">primary_menu</property>
                    <property name="tooltip-text">Main Menu</property>
                  </object>
                </child>

                <!--
                <child type="end">
                  <object class="GtkBox">
                    <style>
                      <class name="linked" />
                    </style>
                    <property name="visible">true</property>
                    <property name="halign">center</property>
                    <property name="valign">right</property>
                 -->

                <child type="end">
                  <object class="GtkToggleButton" id="button_hide_untagged">
                    <style>
                      <!--
                      <class name="success" />
                      -->
                    </style>
                    <property name="visible">false</property>
                    <property name="icon_name">view-conceal-symbolic</property>
                    <property name="tooltip-text" translatable="yes" context="tooltip">Hide untagged</property>
                    <property name="action-name">win.hide_untagged_lines</property>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkToggleButton" id="button_search">
                    <property name="visible">false</property>
                    <property name="icon-name">edit-find-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Search</property>
                    <property name="action-name">win.action_toggle_search</property>
                  </object>
                </child>
                <child type="end">
                  <object class="AdwSplitButton" id="button_tags">
                    <property name="visible">false</property>
                    <property name="icon-name">list-add-symbolic</property>
                    <property name="popover">file_popover</property>
                    <property name="tooltip-text" translatable="yes" context="tooltip">New Tag</property>
                    <property name="action-name">win.action_add_tag</property>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkToggleButton" id="button_minimap">
                    <property name="visible">false</property>
                    <property name="icon-name">sidebar-show-right-symbolic</property>
                    <property name="tooltip-text">Minimap</property>
                    <property name="action-name">win.action_toggle_minimap</property>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkToggleButton" id="button_tags_list">
                    <property name="visible">true</property>
                    <property name="icon-name">sidebar-show</property>
                    <property name="tooltip-text" translatable="yes" context="tooltip">Tag List</property>
                    <property name="action-name">win.toggle_tags_view</property>
                  </object>
                </child>

                <!--
                </object>
                </child>
                -->

              </object>
            </child>
            <property name="content">
              <object class="AdwToastOverlay" id="overlay" />
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>

  <!-- Additional data -->

  <object class="GtkPopoverMenu" id="file_popover">
    <property name="menu-model">secondary_menu</property>
  </object>

  <menu id="secondary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">New tag</attribute>
        <attribute name="action">win.action_add_tag</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Save tagged</attribute>
        <attribute name="action">win.save_tagged</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section> 
    <section>
      <item>
        <attribute name="label" translatable="yes">Load tags</attribute>
        <attribute name="action">win.action_load_tags</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Save tags</attribute>
        <attribute name="action">win.action_save_tags</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Remove tags</attribute>
        <attribute name="action">win.action_remove_all_tags</attribute>
      </item>
    </section>
    <section>
      <!--
      <item>
        <attribute name="label" translatable="yes">View</attribute>
        <attribute name="action">none</attribute>
        <attribute name="disabled">true</attribute>
      </item>
      -->
      <!--
      <item>
        <attribute name="label" translatable="yes">Hide tags list</attribute>
        <attribute name="action">win.toggle_tags_view</attribute>
      </item>
      -->
      <item>
        <attribute name="label" translatable="yes">Hide untagged</attribute>
        <attribute name="action">win.hide_untagged_lines</attribute>
      </item>
      <!--
      <item>
        <attribute name="label" translatable="yes">Hide Minimap</attribute>
        <attribute name="action">win.toggle_minimap</attribute>
      </item>
      -->
    </section>
  </menu>

  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">New Window</attribute>
        <attribute name="action">app.new_window</attribute>
      </item>
    </section>  
    <section>
      <item>
        <attribute name="label" translatable="yes">Save Tagged Lines</attribute>
        <attribute name="action">win.save_tagged</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">File Information</attribute>
        <attribute name="action">win.show_fileinfo</attribute>
      </item>
    </section>  
    <section>
      <item>
        <attribute name="label" translatable="yes">Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Keyboard Shortcuts</attribute>
        <attribute name="action">win.show-help-overlay</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">About Tags</attribute>
        <attribute name="action">app.about</attribute>
      </item>
      </section>
  </menu>
</interface>
