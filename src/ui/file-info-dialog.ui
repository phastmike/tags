<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name file-info-dialog.ui -->
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.7"/>
  <template class="TagsFileInfoDialog" parent="AdwDialog">
    <property name="width-request">600</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="AdwToolbarView">
            <property name="content">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup">
                    <child>
                      <object class="AdwActionRow" id="row_filename">
                        <property name="css-classes">property
monospace</property>
                        <property name="subtitle">--</property>
                        <property name="title">Filename</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="row_folder">
                        <property name="css-classes">property
monospace</property>
                        <property name="subtitle">--</property>
                        <property name="title">Folder</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="row_size">
                        <property name="css-classes">property
monospace</property>
                        <property name="subtitle">--</property>
                        <property name="title">Size</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="row_lines_n">
                        <property name="css-classes">property
monospace</property>
                        <property name="subtitle">--</property>
                        <property name="title">Lines</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="title-widget">
                  <object class="GtkLabel">
                    <property name="css-classes">title</property>
                    <property name="label">File Information</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
