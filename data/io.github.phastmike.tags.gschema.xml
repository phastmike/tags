<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="tags">
   <schema id="io.github.phastmike.tags" path="/io/github/phastmike/tags/" gettext-domain="tags">

      <key name="line-numbers-visible" type="b">
        <default>true</default>
        <summary>Line numbers visibility</summary>
        <description>Toggle line numbers visibility</description>
      </key>

      <key name="tags-autoload" type="b">
         <default>false</default>
         <summary>Autoload tags files</summary>
         <description>Autoload tags files if filename.tags exists</description>
      </key>

      <key name="minimap-visible" type="b">
        <default>true</default>
        <summary>Minimap visibility</summary>
        <description>Toggle minimap visibility</description>
      </key>

      <key name="wrap-nlines" type="u">
        <default>2</default>
        <summary>Wrap lines</summary>
        <description>Number of lines for row text wrap</description>
      </key>

   </schema>
</schemalist>
